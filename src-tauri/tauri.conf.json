{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "报告工坊",
  "version": "0.1.0",
  "identifier": "com.muban.reportstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "报告工坊",
        "width": 820,
        "height": 560,
        "minWidth": 640,
        "minHeight": 440,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["templates/**/*"],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "a2423c7a-9e59-5886-b760-79d5274b3c81"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
