{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "报告工坊",
  "version": "0.1.3",
  "mainBinaryName": "report-studio",
  "identifier": "com.muban.reportstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "报告工坊",
        "width": 820,
        "height": 560,
        "minWidth": 640,
        "minHeight": 440,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "a2423c7a-9e59-5886-b760-79d5274b3c81"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEMjA0QkZGOUY1MDg1NUEKUldSYWhWQ2YvMHNnZlpRNUxjVkcrZU83cHdXak1nVlZ5YVYwYWNDT2Z6eUxRZEp2ZER6RnViY20K",
      "endpoints": [
        "https://oilu.cn/reportStudio/downloads/latest.json",
        "https://github.com/2061360308/reportStudio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
