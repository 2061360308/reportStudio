{
  "schemaVersion": 1,
  "id": "start-completion-report",
  "version": "1.0.1",
  "contentHash": "",
  "name": "开竣工报告、竣工验收证明书",
  "minAppVersion": "0.1.0",
  "assetsPath": "assets",
  "pagesPath": "pages",
  "variables": [
    {
      "key": "project_name",
      "alias": "工程名称",
      "type": "string",
      "required": true,
      "sample": "云冈区实验中学室内地面维修工程"
    },
    {
      "key": "site",
      "alias": "工程地点",
      "type": "string",
      "required": true,
      "sample": "大同市云冈区实验中学校"
    },
    {
      "key": "project_content",
      "alias": "工程内容",
      "type": "text",
      "required": true,
      "sample": "室内地面维修"
    },
    {
      "key": "structure_type",
      "alias": "结构类型",
      "type": "string"
    },
    {
      "key": "owner",
      "alias": "建设单位",
      "type": "string",
      "required": true,
      "sample": "大同市云冈区实验中学校"
    },
    {
      "key": "contractor",
      "alias": "施工单位",
      "type": "string",
      "required": true,
      "sample": "大同市铭诚科贸有限公司"
    },
    {
      "key": "supervisor",
      "alias": "监理单位",
      "type": "string",
      "help": "无监理可留空"
    },
    {
      "key": "building_area",
      "alias": "建筑面积",
      "type": "string"
    },
    {
      "key": "floors",
      "alias": "层数",
      "type": "string"
    },
    {
      "key": "budget",
      "alias": "预算造价",
      "type": "string"
    },
    {
      "key": "plan_start_date",
      "alias": "计划开工日期",
      "type": "date",
      "sample": "2026-07-01"
    },
    {
      "key": "plan_end_date",
      "alias": "计划竣工日期",
      "type": "date",
      "sample": "2026-07-06"
    },
    {
      "key": "actual_start_date",
      "alias": "实际开工日期",
      "type": "date",
      "sample": "2026-07-01"
    },
    {
      "key": "actual_end_date",
      "alias": "实际竣工日期",
      "type": "date",
      "sample": "2026-07-06"
    },
    {
      "key": "actual_work_days",
      "alias": "实际工期",
      "type": "computed",
      "expression": "days_between(plan_start_date, plan_end_date)",
      "help": "按计划开竣工日期自动计算"
    },
    {
      "key": "plan_work_days",
      "alias": "计划工期",
      "type": "computed",
      "expression": "actual_work_days",
      "help": "等于实际工期"
    },
    {
      "key": "contract_no",
      "alias": "合同编号",
      "type": "string"
    },
    {
      "key": "approval_no",
      "alias": "工程批准文号",
      "type": "string"
    }
  ],
  "toc": [
    {
      "title": "开工报告",
      "page": 1
    },
    {
      "title": "竣工报告",
      "page": 2
    },
    {
      "title": "竣工验收证明书",
      "page": 3
    }
  ],
  "pages": [
    {
      "file": "pages/p01.html",
      "order": 1,
      "size": "A4",
      "orientation": "landscape",
      "margin": "0",
      "mt": "7.06mm",
      "mr": "17.89mm",
      "mb": "7.06mm",
      "ml": "17.13mm"
    },
    {
      "file": "pages/p02.html",
      "order": 2,
      "size": "A4",
      "orientation": "landscape",
      "margin": "0",
      "mt": "7.06mm",
      "mr": "17.89mm",
      "mb": "7.06mm",
      "ml": "17.13mm"
    },
    {
      "file": "pages/p03.html",
      "order": 3,
      "size": "A4",
      "orientation": "landscape",
      "margin": "0",
      "mt": "7.06mm",
      "mr": "21.49mm",
      "mb": "7.06mm",
      "ml": "18.49mm"
    }
  ]
}
