{
  "schemaVersion": 1,
  "id": "settle-audit-report",
  "version": "1.0.0",
  "contentHash": "",
  "name": "竣工结算审核报告",
  "entry": "pages/p01.html",
  "variables": [
    {
      "key": "project_name",
      "alias": "工程名称",
      "type": "string",
      "required": true,
      "sample": "怀仁市城镇第六小学校外墙修缮改造工程"
    },
    {
      "key": "site",
      "alias": "工程地点",
      "type": "string",
      "sample": "怀仁市城镇第六小学校"
    },
    {
      "key": "owner",
      "alias": "建设单位",
      "type": "string",
      "required": true,
      "sample": "怀仁市城镇第六小学校"
    },
    {
      "key": "contractor",
      "alias": "施工单位",
      "type": "string",
      "required": true,
      "sample": "山西尊盛达建设工程有限公司"
    },
    {
      "key": "agency",
      "alias": "中介机构",
      "type": "string",
      "sample": "山西红实工程项目管理有限公司"
    },
    {
      "key": "contract_no",
      "alias": "委托合同书编号",
      "type": "string",
      "sample": "SXHS-2026-243"
    },
    {
      "key": "audit_date",
      "alias": "审定日期",
      "type": "computed",
      "expression": "audit_end_date"
    },
    {
      "key": "reported_amount",
      "alias": "报审金额",
      "type": "money",
      "unit": "元",
      "required": true,
      "sample": 140422.9
    },
    {
      "key": "audit_fee",
      "alias": "审计费",
      "type": "computed",
      "unit": "元",
      "expression": "((reported_amount * 0.0035 + deducted_amount * 0.06) | round)"
    },
    {
      "key": "deducted_amount",
      "alias": "核减金额",
      "type": "computed",
      "unit": "元",
      "expression": "reported_amount - approved_amount"
    },
    {
      "key": "approved_amount",
      "alias": "审定金额",
      "type": "money",
      "unit": "元",
      "required": true,
      "sample": 135613.17
    },
    {
      "key": "survey_date",
      "alias": "现场勘测时间",
      "type": "computed",
      "expression": "plan_start_date"
    },
    {
      "key": "start_date",
      "alias": "工程开工时间",
      "type": "date",
      "sample": "2026-07-27"
    },
    {
      "key": "end_date",
      "alias": "工程竣工时间",
      "type": "date",
      "sample": "2026-08-18"
    },
    {
      "key": "accept_date",
      "alias": "工程验收时间",
      "type": "date",
      "sample": "2026-08-20"
    },
    {
      "key": "plan_start_date",
      "alias": "审计计划开工时间",
      "type": "date",
      "sample": "2026-09-07"
    },
    {
      "key": "plan_end_date",
      "alias": "审计计划竣工时间",
      "type": "date",
      "sample": "2026-09-11"
    },
    {
      "key": "audit_start_date",
      "alias": "审计开工时间",
      "type": "computed",
      "expression": "plan_start_date"
    },
    {
      "key": "audit_end_date",
      "alias": "审计竣工时间",
      "type": "computed",
      "expression": "plan_end_date"
    },
    {
      "key": "auditor",
      "alias": "审计人员",
      "type": "string",
      "sample": "张美青"
    },
    {
      "key": "scope",
      "alias": "工程内容",
      "type": "text",
      "help": "20字以内",
      "sample": "拆除文化墙砖面层、涂料面层、雨棚、挑檐涂料面层，恢复墙面、挑檐面层"
    },
    {
      "key": "contract_date",
      "alias": "审计合同签订日期",
      "type": "date",
      "sample": "2026-09-07"
    }
  ],
  "output": {
    "pageSize": "A4",
    "printBackgrounds": true,
    "headerFooter": false
  },
