{
  "schemaVersion": 1,
  "id": "image-layout",
  "version": "1.3.0",
  "contentHash": "",
  "name": "图片排版",
  "minAppVersion": "0.2.3",
  "assetsPath": "assets",
  "pagesPath": "pages",
  "variables": [
    {
      "key": "layout",
      "alias": "排列方式",
      "type": "select",
      "default": "one",
      "sample": "one",
      "allowEmpty": false,
      "options": [
        {
          "value": "one",
          "label": "一页一张"
        },
        {
          "value": "two",
          "label": "一页两张"
        },
        {
          "value": "four",
          "label": "一页四张"
        },
        {
          "value": "smart",
          "label": "智能排版"
        }
      ]
    },
    {
      "key": "images",
      "alias": "图片",
      "type": "images",
      "required": true,
      "accept": [
        "png",
        "jpg",
        "jpeg",
        "bmp",
        "webp",
        "gif"
      ]
    },
    {
      "key": "smart_max",
      "alias": "每页最多",
      "type": "select",
      "default": "6",
      "sample": "6",
      "visibleWhen": {
        "key": "layout",
        "equals": "smart"
      },
      "options": [
        {
          "value": "4",
          "label": "4 张"
        },
        {
          "value": "6",
          "label": "6 张"
        },
        {
          "value": "8",
          "label": "8 张"
        },
        {
          "value": "12",
          "label": "12 张"
        }
      ],
      "help": "仅智能排版生效"
    },
    {
      "key": "smart_balance",
      "alias": "行高均衡",
      "type": "select",
      "default": "0",
      "sample": "0",
      "visibleWhen": {
        "key": "layout",
        "equals": "smart"
      },
      "options": [
        {
          "value": "0",
          "label": "不限制"
        },
        {
          "value": "1.8",
          "label": "1.8 倍"
        },
        {
          "value": "1.6",
          "label": "1.6 倍"
        },
        {
          "value": "1.4",
          "label": "1.4 倍"
        }
      ],
      "help": "限制同页最高行与最矮行的比例，越小越整齐"
    },
    {
      "key": "smart_stretch",
      "alias": "最大形变",
      "type": "select",
      "default": "0.08",
      "sample": "0.08",
      "visibleWhen": {
        "key": "layout",
        "equals": "smart"
      },
      "options": [
        {
          "value": "0",
          "label": "0%"
        },
        {
          "value": "0.05",
          "label": "5%"
        },
        {
          "value": "0.08",
          "label": "8%"
        },
        {
          "value": "0.12",
          "label": "12%"
        }
      ],
      "help": "仅智能排版生效"
    },
    {
      "key": "smart_min",
      "alias": "最小短边",
      "type": "select",
      "default": "30",
      "sample": "30",
      "visibleWhen": {
        "key": "layout",
        "equals": "smart"
      },
      "options": [
        {
          "value": "25",
          "label": "25mm"
        },
        {
          "value": "30",
          "label": "30mm"
        },
        {
          "value": "35",
          "label": "35mm"
        },
        {
          "value": "40",
          "label": "40mm"
        },
        {
          "value": "45",
          "label": "45mm"
        }
      ],
      "help": "打印后图片短边的最小尺寸"
    },
    {
      "key": "smart_order",
      "alias": "排序方式",
      "type": "select",
      "default": "smart",
      "sample": "smart",
      "visibleWhen": {
        "key": "layout",
        "equals": "smart"
      },
      "options": [
        {
          "value": "smart",
          "label": "智能排序"
        },
        {
          "value": "original",
          "label": "保持上传顺序"
        }
      ],
      "help": "仅智能排版生效"
    }
  ],
  "toc": [
    {
      "title": "图片排版",
      "page": 1
    }
  ],
  "pages": [
    {
      "file": "pages/p01.html",
      "mode": "flow",
      "order": 1,
      "size": "A4",
      "orientation": "portrait",
      "margin": "0",
      "mt": "10mm",
      "mr": "10mm",
      "mb": "10mm",
      "ml": "10mm"
    }
  ]
}
