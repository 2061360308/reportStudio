{
  "name": "report-studio",
  "version": "0.2.2",
  "description": "工程报告生成工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "dev:template": "cargo build --manifest-path src-tauri/Cargo.toml -p report-dev && src-tauri\\target\\debug\\report-dev.exe",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "release:plan": "node scripts/check-versions.mjs",
    "release:merge": "node scripts/merge-latest.mjs",
    "updater:configure": "node scripts/configure-updater.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/svelte": "^1.57.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "handsontable": "^14.6.1",
    "paneforge": "^1.0.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
